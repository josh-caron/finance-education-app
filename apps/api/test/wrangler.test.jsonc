{
  // Test-only config. It declares just the D1 binding the routes need, so tests
  // do not depend on the built web client, cron triggers, or a Cloudflare account.
  "name": "fin-edu-api-test",
  "main": "../src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fin-edu-test",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
}
