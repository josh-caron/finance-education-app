# Local overrides for `wrangler dev`, layered on top of the vars in
# wrangler.jsonc so the committed config can hold the deployed values.
#
# `pnpm setup:local` writes apps/api/.dev.vars for you with a freshly generated
# secret. Copy this by hand only if you would rather do it yourself.
#
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-random-32-byte-secret"
BETTER_AUTH_URL="http://localhost:8787"
TRUSTED_ORIGINS="http://localhost:8081,http://localhost:8787,fineduapp://"
