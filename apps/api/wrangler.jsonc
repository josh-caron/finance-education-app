{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fin-edu-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fin-edu-db",
      // Replace with the id printed by: wrangler d1 create fin-edu-db
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      // Migrations are generated by @fin/db (pnpm db:generate).
      "migrations_dir": "../../packages/db/drizzle",
    },
  ],

  "vars": {
    "BETTER_AUTH_URL": "http://localhost:8787",
    // Origins allowed to send credentialed requests. The expo:// scheme covers
    // the native app, localhost:8081 the Expo web dev server.
    "TRUSTED_ORIGINS": "http://localhost:8081,fineduapp://",
  },

  // BETTER_AUTH_SECRET is a secret, not a var:
  //   local:  apps/api/.dev.vars
  //   remote: wrangler secret put BETTER_AUTH_SECRET
}
