{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fin-edu-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Pinned so a token with access to more than one account cannot deploy this
  // somewhere unintended.
  "account_id": "49eb1c70d2cacb99fe5701d8becf3d4a",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fin-edu-db",
      "database_id": "0e131d9d-3710-4f7f-a46a-5161f1736bb9",
      // Migrations are generated by @fin/db (pnpm db:generate).
      "migrations_dir": "../../packages/db/drizzle",
    },
  ],

  // These are the deployed values. `wrangler dev` reads apps/api/.dev.vars on
  // top of them, and that file points everything back at localhost, so local
  // development does not need a second copy of this config.
  //
  // TODO: after the first deploy, replace <subdomain> with the one wrangler
  // prints and deploy again, or Better Auth will reject its own callbacks.
  "vars": {
    "BETTER_AUTH_URL": "https://fin-edu-api.<subdomain>.workers.dev",
    // Origins allowed to send credentialed requests: the deployed web client
    // and the native app's scheme.
    "TRUSTED_ORIGINS": "https://fin-edu-api.<subdomain>.workers.dev,fineduapp://",
  },

  // BETTER_AUTH_SECRET is a secret, never a var:
  //   local:  apps/api/.dev.vars, written by `pnpm setup`
  //   remote: wrangler secret put BETTER_AUTH_SECRET
}
