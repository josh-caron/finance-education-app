{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fin-edu-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Clears elapsed rate-limit windows once a day. Active keys are reset in
  // place by the limiter, so this only removes keys seen once and never again.
  "triggers": {
    "crons": ["17 4 * * *"],
  },

  // Pinned so a token with access to more than one account cannot deploy this
  // somewhere unintended.
  "account_id": "49eb1c70d2cacb99fe5701d8becf3d4a",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fin-edu-db",
      "database_id": "0e131d9d-3710-4f7f-a46a-5161f1736bb9",
      // Migrations are generated by @fin/db (pnpm db:generate).
      "migrations_dir": "../../packages/db/drizzle",
    },
  ],

  // The Expo web export is served by this same Worker, so the client and the
  // API share an origin: no CORS, and a first-party session cookie.
  //
  // Requests are matched against the built files first; anything the Worker
  // must own is listed in run_worker_first. Build the bundle before deploying
  // (`pnpm deploy:api` does both).
  "assets": {
    "directory": "../mobile/dist",
    "run_worker_first": ["/api/*", "/health"],
    // The Expo export writes a real page per route, so a miss is a genuine 404
    // rather than a client-routed path.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },

  // These are the deployed values. `wrangler dev` reads apps/api/.dev.vars on
  // top of them, and that file points everything back at localhost, so local
  // development does not need a second copy of this config.
  //
  // BETTER_AUTH_URL must equal the origin the app is served from. Better Auth
  // compares the request's Origin header against it, and a mismatch fails with
  // "Invalid origin" on the sign-in form, which reads as broken auth rather
  // than bad config.
  "vars": {
    "BETTER_AUTH_URL": "https://fin-edu-api.joshcaron.workers.dev",
    // Only cross-origin callers need listing. The web client is same-origin
    // now, so this is just the native app's scheme.
    "TRUSTED_ORIGINS": "fineduapp://",
  },

  // Auth email is off until EMAIL_FROM is added here and RESEND_API_KEY is set
  // as a secret; see "Email" in docs/operations.md.
  //
  // BETTER_AUTH_SECRET is a secret, never a var:
  //   local:  apps/api/.dev.vars, written by `pnpm setup:local`
  //   remote: wrangler secret put BETTER_AUTH_SECRET
}
