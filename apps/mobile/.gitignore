# expo-env.d.ts is generated by `expo start`, and Expo's default is to ignore it.
# We commit it instead: `pnpm typecheck` needs it for the CSS side-effect import
# in constants/theme.ts, and CI typechecks without ever starting Metro.
#
# `expo install` re-adds a generated block ignoring it. Harmless, since the file
# is already tracked, but delete the block again to keep this file honest.
